#!/usr/bin/env bash
# pre-commit — Verificaciones locales antes de cada commit en startai.
#
#   1. Validación de config.example.json + coherencia de templates (--check)
#   2. Anti-secretos: escanea el CONTENIDO de los blobs staged (git show ":file")
#   3. Rutas privadas en el índice (defensa estructural anti-leak)
#   4. Integridad del .gitignore staged (conserva los patrones privados)
#   5. .devinignore staged no niega secretos
#   6. (hueco) Aviso temprano de advisories — no aplica: startai no tiene
#      lockfile ni herramienta de advisories de ecosistema.
#
# Los pasos 2-5 necesitan git: fuera de un repo (o sin git) degradan a aviso,
# no a error — el hook solo bloquea con evidencia, nunca por infraestructura.
#
# Instalar:
#   bash scripts/git/install-hooks.sh

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$PROJECT_ROOT"

# ─── 1. Validación de config + coherencia de templates ───────────────────
echo "🔍 Validando config.example.json y coherencia de templates..."
if ! python3 scripts/startai.py --check; then
    echo "" >&2
    echo "  ❌ La validación falló. Corrige y reintenta." >&2
    echo "  Escape puntual (NO recomendado): git commit --no-verify" >&2
    exit 1
fi
echo "  ✅ Config y templates coherentes"

# ─── Contexto git (degradación limpia fuera de un repo) ──────────────────
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "  ⚠️  No es un repo git — se saltan las comprobaciones de blobs/índice" >&2
    exit 0
fi

# Ficheros staged (Added/Copied/Modified). Se lee el BLOB del índice
# (git show ":file"), nunca el worktree: escanear el worktree producía falsos
# negativos (leak en índice pero borrado del worktree → pasaba) y falsos
# positivos (leak solo en worktree, nada staged → bloqueaba sin motivo).
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

# ─── 2. Anti-secretos en blobs staged ─────────────────────────────────────
# Mantener sincronizada con checks/01_secrets_and_creds.sh: mismo conjunto
# de patrones, aquí aplicado a blobs staged en vez de al worktree.
echo "🔍 Escaneando blobs staged por secretos/credenciales..."
SECRET_REGEXES=(
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'AKIA[0-9A-Z]{16}'
    'AIza[0-9A-Za-z_-]{35}'
    'sk-[a-zA-Z0-9]{30,}'
    'gsk_[a-zA-Z0-9]{30,}'
    'xai-[a-zA-Z0-9]{30,}'
    'ghp_[a-zA-Z0-9]{36}'
    'gho_[a-zA-Z0-9]{36}'
    'ghs_[a-zA-Z0-9]{36}'
    'eyJ[a-zA-Z0-9_-]{20,}\.[a-zA-Z0-9_-]{20,}\.[a-zA-Z0-9_-]{20,}'
    'Bearer [a-zA-Z0-9_-]{40,}'
    '(postgres|mysql|mongodb|redis)://[^:]+:[^@]+@'
    '(password|passwd|api_key|apikey|secret|token)[[:space:]]*[=:][[:space:]]*["'\''][^$<{"'\'']{4,}["'\'']'
)

# Exclusiones: ficheros trackeados que contienen los propios patrones por
# definición; sin excluirlos el hook se autobloquearía al commitear cambios
# sobre sí mismo. Añadir aquí (con motivo) cualquier falso positivo legítimo.
SCAN_EXCLUDE=(
    'scripts/git/pre-commit'           # este hook (contiene SECRET_REGEXES)
    'templates/scripts/git/pre-commit' # su gemelo de plantilla
)

FOUND_LEAKS=0
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    skip=0
    for ex in "${SCAN_EXCLUDE[@]}"; do
        [[ "$file" == "$ex" ]] && skip=1 && break
    done
    [[ "$skip" -eq 1 ]] && continue
    content=$(git show ":$file" 2>/dev/null) || continue
    for re in "${SECRET_REGEXES[@]}"; do
        if printf '%s\n' "$content" | grep -qiIE -e "$re"; then
            echo "❌ SECRETO en blob staged: patrón '$re' en $file" >&2
            FOUND_LEAKS=1
        fi
    done
done <<< "$STAGED_FILES"

if [[ "$FOUND_LEAKS" -ne 0 ]]; then
    echo "" >&2
    echo "  Nunca se commitean secretos. Para sacar del índice:" >&2
    echo "    git rm --cached <ruta>" >&2
    echo "  Escape puntual (NO recomendado): git commit --no-verify" >&2
    exit 1
fi
echo "  ✅ Sin secretos en blobs staged"

# ─── 3-5. Defensa estructural anti-leak ──────────────────────────────────
# Si .gitignore se relaja alguna vez (p.ej. para un workflow puntual) o se
# usa `git add -f`, rutas que JAMÁS deben publicarse podrían quedar staged.
#
# Las listas de abajo DUPLICAN la política canónica del perfil de auditoría:
# mantener sincronizadas con scripts/dev/audit/profiles/startai.conf
# (PRIVATE_GLOBS / PUBLIC_EXCEPTIONS / REQUIRED_GITIGNORE). Se duplican a
# propósito: scripts/dev/ es privado (gitignored) y un clon limpio no lo
# tiene — el hook debe proteger también sin él.
PRIVATE_GLOBS=(
    'AGENTS.md'
    '.agents/*'
    'CLAUDE.md'
    '.claude/*'
    '.devin/*'
    '.devinignore'
    '.codeiumignore'
    '.windsurfignore'
    'NOTES.md'
    'MEGAPLAN-*.md'
    'history_*.md'
    'preview.txt'
    'docs/dev/*'
    'scripts/dev/*'
    'security-audit/*'
    '*.key'
    '*.pem'
    '*.p12'
    '*.pfx'
    '.env'
    '.env.*'
    'minisign.key'
)

# Excepciones públicas: el CONTENIDO de las plantillas es público a propósito.
PUBLIC_EXCEPTIONS=(
    'templates/AGENTS.md'
    'templates/.agents/*'
    'templates/.devinignore'
    'templates/gitignore'
    'templates/scripts/dev/*'
)

# Líneas literales que DEBEN seguir presentes en un .gitignore staged.
REQUIRED_GITIGNORE=(
    '**/AGENTS.md'
    '!templates/AGENTS.md'
    '.agents/'
    '!templates/.agents/'
    '!templates/.agents/**'
    'CLAUDE.md'
    '.claude/'
    '.devin/'
    '.devinignore'
    '!templates/.devinignore'
    'NOTES.md'
    'MEGAPLAN-*.md'
    'preview.txt'
    '/docs/dev/'
    '/scripts/dev/'
    '/security-audit/'
    '*.key'
    '*.pem'
    '.env'
    '.env.*'
)

is_private_path() {
    local f="$1" g
    for g in "${PUBLIC_EXCEPTIONS[@]:-}"; do
        [[ "$f" == $g ]] && return 1
    done
    for g in "${PRIVATE_GLOBS[@]:-}"; do
        # verbatim + "<dir>/glob" (un patrón .gitignore sin '/' inicial
        # casa a cualquier nivel)
        [[ "$f" == $g || "$f" == */$g ]] && return 0
    done
    return 1
}

# ─── 3. Rutas privadas staged ────────────────────────────────────────────
PRIVATE_STAGED=0
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if is_private_path "$file"; then
        echo "❌ RUTA PRIVADA staged: $file" >&2
        PRIVATE_STAGED=1
    fi
done <<< "$STAGED_FILES"

# ─── 4. Integridad del .gitignore staged ─────────────────────────────────
# El worktree podría estar restaurado pero el índice no: hay que mirar el blob.
if printf '%s\n' "$STAGED_FILES" | grep -qx '.gitignore'; then
    STAGED_GI="$(git show ':.gitignore' 2>/dev/null || true)"
    for pat in "${REQUIRED_GITIGNORE[@]:-}"; do
        if ! printf '%s\n' "$STAGED_GI" | grep -Fxq "$pat"; then
            echo "❌ .gitignore staged elimina el patrón privado: '$pat'" >&2
            PRIVATE_STAGED=1
        fi
    done
fi

# ─── 5. .devinignore staged no niega secretos ────────────────────────────
# Las negaciones '!' des-ignoran rutas SOLO para las tools del agente; negar
# un secreto lo metería en contexto IA. Se audita el blob staged de cualquier
# .devinignore (raíz o templates/). Mantener el regex sincronizado con el
# check 23.4 del framework de auditoría.
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    case "$file" in
        .devinignore|*/.devinignore) ;;
        *) continue ;;
    esac
    blob=$(git show ":$file" 2>/dev/null) || continue
    BAD_NEG=$(printf '%s\n' "$blob" | grep -nE '^!' \
        | grep -iE 'key|pem|p12|pfx|env|secret|session\.json|providers\.|credential|passwd' \
        || true)
    if [ -n "$BAD_NEG" ]; then
        echo "❌ $file staged niega posibles secretos:" >&2
        printf '    %s\n' "$BAD_NEG" >&2
        PRIVATE_STAGED=1
    fi
done <<< "$STAGED_FILES"

if [[ "$PRIVATE_STAGED" -ne 0 ]]; then
    echo "" >&2
    echo "  Rutas privadas no se publican NUNCA. Para sacar del índice:" >&2
    echo "    git rm --cached <ruta>" >&2
    echo "  Si la publicación es deliberada (raro): git commit --no-verify" >&2
    exit 1
fi
echo "  ✅ Sin rutas privadas en el índice"

# ─── 6. Aviso temprano de advisories (hueco — NO bloqueante) ─────────────
# startai no tiene lockfile ni herramienta de advisories de ecosistema.
# Si se añade una (p.ej. pip-audit con requirements.txt), seguir el patrón
# de enola-cli-lite/scripts/git/pre-commit §6: avisar aquí con la DB cacheada
# (--no-fetch / equivalente, sin red) y dejar el bloqueo autoritativo al
# pre-push. NUNCA bloquear en commit: un advisory upstream no debe impedir
# commitear trabajo local en curso.

echo "  ✅ pre-commit OK"
exit 0
